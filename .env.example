# Copy to .env and adjust for local development.
DB_NAME=ptu_social
DB_USER=ptu
DB_PASSWORD=ptu
DB_PORT=5432

REDIS_PASSWORD=redis
REDIS_PORT=6379

# Единственная точка входа — nginx (бэкенд наружу не публикуется)
HTTP_PORT=80
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Links sent in emails (frontend URL, frontend not implemented yet)
APP_BASE_URL=http://localhost:3000
MAIL_FROM=no-reply@ptu.local

# Registration request / teacher invite lifetime
REGISTRATION_TTL=7d
INVITE_TTL=7d

# JWT (HS256, >= 32 bytes)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT_TTL=24h

# Rate limiting (Redis, fixed window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_REQUESTS=120
RATE_LIMIT_AUTHENTICATED_WINDOW=1m
RATE_LIMIT_ANONYMOUS_REQUESTS=60
RATE_LIMIT_ANONYMOUS_WINDOW=1m

# Dev seeder (@Profile("dev")): academic office account
SEED_OFFICE_EMAIL=office@ptu.local
SEED_OFFICE_PASSWORD=office12345

# Reviews: currency reward and monthly cap per student
REVIEW_REWARD_AMOUNT=5
REVIEW_MONTHLY_LIMIT=5
